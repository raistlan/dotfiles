// Zed settings
//
// Personal, machine-agnostic preferences only. Anything tied to a specific
// repo — formatters, linters, language servers — belongs in that repo's
// own .zed/settings.json so it can't leak into unrelated projects.
//
// Docs: https://zed.dev/docs/configuring-zed
{
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "terminal": {
    "font_size": 13.0
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "proxy": "",
  "ui_font_size": 16.0,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark"
  }
}
