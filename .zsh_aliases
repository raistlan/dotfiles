alias aliases="vim ~/development/dotfiles/.zsh_aliases && source ~/.zshrc"

# --- Git ---
alias ga="git add ."
alias gco="git checkout"
alias gcm="git commit -m"
alias gpoh="git push -u origin HEAD"

# --- Workflow ---
alias pnrd="git pull && npm run dev"
alias vnrd="git pull && npm i && npm run dev"
alias nrd="npm i && npm run dev"
alias nrds="npm run dev:start"
alias grep='grep --color=auto'

# --- MacOS ---
alias finder='open'
alias whiptail="dialog"

# --- Windows ---
alias explore='explorer.exe'

# --- Navigation ---
alias ll='ls -al --group-directories-first --git'
alias ldir="ll | grep ^d"
alias ..='cd ..'
alias ...='cd ../..'
alias h='history'
alias c='clear'
alias md='mkdir -p'
alias duh='du -sh * | sort -hr'
alias unzip='tar -zxvf'

# --- Kubernetes ---
alias kc='kubectl'

# --- Functions ---
journal() {
  local OPTIND=1
  local mode=""
  local msg="scripted entry"

  # parse flags
  while getopts ":dw" opt; do
    case "$opt" in
      p) mode="personal" ;;
      w) mode="work" ;;
      *)
        echo "Usage: journal -p|-w [message]"
        return 1
        ;;
    esac
  done

  shift $((OPTIND - 1))

  # remaining args = message
  if [[ -n "$1" ]]; then
    msg="$*"
  fi

  # determine directory based on mode
  local journal_dir
  case "$mode" in
    diary)
      for journal_dir in \
        "/mnt/c/development/diary" \
        "$HOME/development/diary"
      do
        [[ -d "$journal_dir" ]] && break
      done
      ;;
    work)
      for journal_dir in \
        "/mnt/c/development/workdiary" \
        "$HOME/development/workdiary"
      do
        [[ -d "$journal_dir" ]] && break
      done
      ;;
    *)
      echo "You must specify -p (personal) or -w (work)"
      return 1
      ;;
  esac

  [[ -d "$journal_dir" ]] || {
    echo "Journal directory not found"
    return 1
  }

  git -C "$journal_dir" add . &&
  git -C "$journal_dir" commit -m "$msg" &&
  git -C "$journal_dir" push
}

# Remove the worktree that's holding a branch, so you can check the branch out.
# Usage: wtd <branch> [--force]
wtd() {
  local branch="$1"
  [ -z "$branch" ] && { echo "usage: wtd <branch> [--force]" >&2; return 1; }

  local list
  list=$(/usr/bin/git worktree list --porcelain)

  local path main
  path=$(printf '%s\n' "$list" | /usr/bin/awk -v b="refs/heads/$branch" '
    /^worktree / { wt = substr($0, 10) }
    $0 == "branch " b { print wt; exit }
  ')
  # The first porcelain entry is always the main working tree.
  main=$(printf '%s\n' "$list" | /usr/bin/awk '/^worktree / { print substr($0, 10); exit }')

  [ -z "$path" ] && { echo "wtd: no worktree holds '$branch'" >&2; return 1; }

  if [ "$path" = "$main" ]; then
    echo "wtd: '$branch' is checked out" >&2
    return 1
  fi

  echo "Removing worktree: $path"
  /usr/bin/git worktree remove "$path" "${@:2}"
}
